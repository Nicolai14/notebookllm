# OpenAI (no defaults in code; all values are required)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=

# Demo access
DEMO_PASSWORD=
AUTH_SECRET=

# Supabase (service role key is server-side only and bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for scripts/db-apply.mjs (Management API)
SUPABASE_ACCESS_TOKEN=

# Kill switch for all AI features (chat, summary, embeddings)
AI_FEATURES_ENABLED=true
